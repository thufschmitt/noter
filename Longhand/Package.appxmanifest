<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity Name="Longhand.Prototype" Publisher="CN=Longhand Prototype" Version="0.2.0.0" />

  <Properties>
    <DisplayName>Longhand</DisplayName>
    <PublisherDisplayName>Longhand Prototype</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Longhand.App">
      <uap:VisualElements
        DisplayName="Longhand"
        Description="An endless notebook page: write with a pen, and Claude answers inline."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#FBFCFD" />
      </uap:VisualElements>
      <Extensions>
        <!-- The browser returns here after a sign-in to a connected app (see callback.html on the update site). -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="longhand">
            <uap:DisplayName>Longhand</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
    <!-- Longhand Calendar: the same program, opened on one day of your calendar instead of the notebook (AppKind.IsCalendar).
         Its tiles are green with a calendar page, drawn by tools/make-calendar-icons.py. -->
    <Application Id="Calendar" Executable="$targetnametoken$.exe" EntryPoint="Longhand.App">
      <uap:VisualElements
        DisplayName="Longhand Calendar"
        Description="One day of your calendar: move and resize events with the pen, and draw new ones."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Calendar150x150Logo.png"
        Square44x44Logo="Assets\Calendar44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\CalendarWide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\CalendarSplashScreen.png" BackgroundColor="#FBFCFD" />
      </uap:VisualElements>
    </Application>
    <!-- Longhand Score: the same program, opened on staves to write music on (AppKind.IsScore, ScorePage). Its tiles are plum with a
         staff and two beamed notes, drawn by tools/make-score-icons.py. -->
    <Application Id="Score" Executable="$targetnametoken$.exe" EntryPoint="Longhand.App">
      <uap:VisualElements
        DisplayName="Longhand Score"
        Description="Staves to write music on with the pen: what you write is cleaned up into engraved notation as you go."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Score150x150Logo.png"
        Square44x44Logo="Assets\Score44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\ScoreWide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\ScoreSplashScreen.png" BackgroundColor="#FBFCFD" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
