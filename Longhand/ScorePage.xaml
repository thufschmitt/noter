<Page
    x:Class="Longhand.ScorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <!-- Longhand Score: staves to write music on. The page is laid out at its own width (ScoreSheet.PageWidth) and scaled down to fit
         the window; the engraving and the ink share its coordinates. Fingers scroll, the pen and the mouse write. -->
    <Grid x:Name="Root">
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
            <Viewbox x:Name="Fit" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,90">
                <Grid x:Name="Sheet" Width="1000" Height="1400">
                    <TextBlock x:Name="SheetTitle" Text="LONGHAND SCORE" Margin="36,28,0,0" FontSize="13" FontWeight="SemiBold" CharacterSpacing="80"
                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                    <Border x:Name="Engraving" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                    <InkCanvas x:Name="Ink" />
                </Grid>
            </Viewbox>
        </ScrollViewer>

        <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76"
                CornerRadius="10" BorderThickness="1" Padding="14,10" MaxWidth="520">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13" />
        </Border>

        <Border x:Name="Tray" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" CornerRadius="14" BorderThickness="1" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="EraserButton" Click="Eraser_Click" Style="{StaticResource ToolToggle}" ToolTipService.ToolTip="Eraser: rubs out ink and notation (the pen's eraser end does too)">
                    <FontIcon Glyph="&#xE75C;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="UndoButton" Click="Undo_Click" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                </Button>
                <Button x:Name="ClearButton" Click="Clear_Click" Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Clear the score (Undo brings it back)">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                </Button>
                <Rectangle x:Name="TraySeparator" Width="1" Height="22" Margin="4,0" />
                <Button x:Name="PlayButton" Click="Play_Click" ToolTipService.ToolTip="Play the score" Height="40" Padding="14,0" CornerRadius="20" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="PlayLabel" Text="Play" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
