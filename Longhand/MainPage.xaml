<Page
    x:Class="Longhand.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <!-- Colours are set from code (see ApplyTheme) so ink, rules and notes follow the system theme together. -->
    <Grid x:Name="Root">
        <!-- One endless ruled sheet. Pen and mouse write; touch scrolls (unless finger writing is on). -->
        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Enabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled"
            SizeChanged="Scroller_SizeChanged">
            <Grid x:Name="Sheet" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Canvas x:Name="RuleLayer" IsHitTestVisible="False" />
                <Canvas x:Name="NoteLayer" IsHitTestVisible="False" />
                <InkCanvas x:Name="Ink" />
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="ToastBox"
            Margin="16"
            Padding="14,10"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed">
            <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- A box to type a note instead of writing it; opened with the keyboard button. -->
        <Border
            x:Name="TypeBar"
            Margin="12,0,12,76"
            Padding="8"
            Width="560"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TypeBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="140" MaxLength="4000"
                         PlaceholderText="Type a note for Claude. Enter sends, Shift+Enter starts a new line."
                         KeyDown="TypeBox_KeyDown" TextChanged="TypeBox_TextChanged" />
                <Button x:Name="TypeSend" Grid.Column="1" Click="TypeSend_Click" VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}" Height="40" Width="44" Padding="0" CornerRadius="20"
                        ToolTipService.ToolTip="Send" AutomationProperties.Name="Send">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <Border
            x:Name="Tray"
            Margin="12,0,12,16"
            Padding="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            BorderThickness="1"
            CornerRadius="26">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="PenButton" IsChecked="True" Click="Pen_Click" Style="{StaticResource ToolToggle}"
                              ToolTipService.ToolTip="Pen" AutomationProperties.Name="Pen">
                    <FontIcon Glyph="&#xE76D;" FontSize="18" />
                </ToggleButton>
                <ToggleButton x:Name="EraserButton" Click="Eraser_Click" Style="{StaticResource ToolToggle}"
                              ToolTipService.ToolTip="Eraser. The pen's eraser end works too." AutomationProperties.Name="Eraser">
                    <FontIcon Glyph="&#xE75C;" FontSize="18" />
                </ToggleButton>
                <Button x:Name="UndoButton" Click="Undo_Click" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE7A7;" FontSize="18" />
                </Button>
                <ToggleButton x:Name="TouchButton" Click="Touch_Click" Style="{StaticResource ToolToggle}"
                              ToolTipService.ToolTip="Write with your finger" AutomationProperties.Name="Write with your finger">
                    <FontIcon Glyph="&#xE7C9;" FontSize="18" />
                </ToggleButton>
                <ToggleButton x:Name="KeyboardButton" Click="Keyboard_Click" Style="{StaticResource ToolToggle}"
                              ToolTipService.ToolTip="Type a note" AutomationProperties.Name="Type a note">
                    <FontIcon Glyph="&#xE765;" FontSize="18" />
                </ToggleButton>
                <!-- The flyout (conversation list) is built in code. -->
                <Button x:Name="ConversationsButton" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Conversations (Ctrl+N for a new one)" AutomationProperties.Name="Conversations">
                    <FontIcon Glyph="&#xE8F1;" FontSize="18" />
                </Button>
                <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="API key" AutomationProperties.Name="API key settings">
                    <FontIcon Glyph="&#xE713;" FontSize="18" />
                </Button>
                <Button x:Name="AppsButton" Click="Apps_Click" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Connected apps" AutomationProperties.Name="Connected apps">
                    <FontIcon Glyph="&#xE71B;" FontSize="18" />
                </Button>
                <Rectangle Width="1" Height="22" Margin="4,0" x:Name="TraySeparator" />
                <Button x:Name="AskButton" Click="Ask_Click" Style="{StaticResource AccentButtonStyle}"
                        Height="40" Padding="14,0" CornerRadius="20" IsEnabled="False"
                        ToolTipService.ToolTip="Ask now (Ctrl+Enter)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" />
                            <!-- Fills while the pause timer runs; Claude answers when it is full. -->
                            <ProgressBar x:Name="Countdown" Maximum="1" Value="0" Width="18" VerticalAlignment="Bottom" Visibility="Collapsed" />
                            <FontIcon x:Name="AskIcon" Glyph="&#xE724;" FontSize="14" />
                        </Grid>
                        <TextBlock x:Name="AskLabel" Text="Ask" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
