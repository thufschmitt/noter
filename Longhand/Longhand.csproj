<Project Sdk="Microsoft.NET.Sdk">
  <!-- UWP on modern .NET 10 (needs Visual Studio 2022 17.14+ or Visual Studio 2026 with the "Universal Windows Platform tools" workload). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Longhand</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The UWP template turns on Native AOT. The Anthropic SDK isn't verified under AOT, so this prototype runs on the JIT. -->
    <PublishAot>false</PublishAot>
    <!-- Without AOT the app would need a separately installed .NET 9 runtime; ship the runtime inside the package instead. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" SubType="Designer" />
    <Content Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.7.0" />
  </ItemGroup>
</Project>
