<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Longhand as a web server: the shared page logic runs here, and a browser shows the page on an HTML canvas. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Longhand.Web</RootNamespace>
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Longhand.Core\Longhand.Core.csproj" />
    <!-- The page itself travels inside the program, so it runs from anywhere. -->
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
