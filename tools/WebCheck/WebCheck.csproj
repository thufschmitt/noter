<Project Sdk="Microsoft.NET.Sdk">
  <!-- Starts the web server on a free port and plays a browser against it, with a fake of the Anthropic API. Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Longhand.Web\Longhand.Web.csproj" />
    <Compile Include="..\CoreCheck\Fakes.cs" Link="Fakes.cs" />
  </ItemGroup>
</Project>
